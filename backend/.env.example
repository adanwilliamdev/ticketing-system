# Todos os valores abaixo já são os padrões do projeto (batem com o docker-compose.yml na raiz).
# Copie para .env somente se precisar mudar algo.
DATABASE_URL=postgresql+asyncpg://ticketing_user:ticketing_pass@localhost:5432/ticketing_db
REDIS_URL=redis://localhost:6379
# Ligue para true ao apontar para um Postgres gerenciado que exija SSL (RDS, Supabase, etc.).
DB_SSL=false

DB_POOL_MAX=20
RESERVATION_TIMEOUT_MINUTES=10
PAYMENT_GATEWAY_DELAY_MS=2000

# Job que expira reservas (a cada EXPIRATION_INTERVAL_MS). Desligue em deploy serverless
# e chame POST /internal/expire-reservations por um cron externo.
EXPIRATION_JOB_ENABLED=true
EXPIRATION_INTERVAL_MS=60000

# Aplica as migrações do Alembic ao subir o servidor.
MIGRATE_ON_STARTUP=true

# Protege /internal/expire-reservations. Sem valor, o endpoint fica desativado.
CRON_SECRET=

# CORS: origem do frontend Next.js.
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
