{
  "name": "ticketing-system-next",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de agendamento e pagamentos com alta concorrência — Next.js + TypeScript",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/*.test.ts\"",
    "migrate": "tsx scripts/migrate.ts",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d --wait postgres redis",
    "infra:down": "docker compose -f docker/docker-compose.yml down"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "next": "^15.5.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
