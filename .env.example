# Todos os valores abaixo já são os padrões do projeto (batem com docker/docker-compose.yml).
# Copie para .env somente se precisar mudar algo.
DATABASE_URL=postgresql://ticketing_user:ticketing_pass@localhost:5432/ticketing_db
REDIS_URL=redis://localhost:6379

RESERVATION_TIMEOUT_MINUTES=10
PAYMENT_GATEWAY_DELAY_MS=2000

# Job que expira reservas (a cada EXPIRATION_INTERVAL_MS). Desligue em deploy serverless
# e chame /api/internal/expire-reservations por um cron externo.
EXPIRATION_JOB_ENABLED=true
EXPIRATION_INTERVAL_MS=60000

# Aplica as migrações em migrations/ ao subir o servidor (equivalente ao Flyway do Spring Boot).
MIGRATE_ON_STARTUP=true

# Protege /api/internal/expire-reservations. Sem valor, o endpoint fica desativado.
CRON_SECRET=
