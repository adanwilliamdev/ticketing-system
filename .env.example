# Todos os valores abaixo já são os padrões do projeto (batem com o docker-compose.yml).
# Exporte as variáveis de ambiente somente se precisar mudar algo.

PORT=8080

# PostgreSQL (JDBC). Para um banco gerenciado que exija SSL, acrescente ?sslmode=require à URL.
DB_URL=jdbc:postgresql://localhost:5432/ticketing_db
DB_USER=ticketing_user
DB_PASSWORD=ticketing_pass
DB_POOL_MAX=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Aplica as migrações do Flyway ao subir a aplicação.
MIGRATE_ON_STARTUP=true

# Insere eventos e assentos de exemplo se o banco ainda estiver vazio.
SEED_ENABLED=false

RESERVATION_TIMEOUT_MINUTES=10
PAYMENT_GATEWAY_DELAY_MS=2000

# Job que expira reservas (a cada EXPIRATION_INTERVAL_MS). Desligue em deploy sem processo permanente
# e chame POST /internal/expire-reservations por um cron externo.
EXPIRATION_JOB_ENABLED=true
EXPIRATION_INTERVAL_MS=60000

# Protege /internal/expire-reservations. Sem valor, o endpoint fica desativado.
CRON_SECRET=

# Fuso horário usado para exibir datas nas páginas.
DISPLAY_ZONE=America/Sao_Paulo

LOG_LEVEL=info
